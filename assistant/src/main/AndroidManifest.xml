<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Same declaration as the :websearch package; either may install first. -->
    <permission
        android:name="io.shubham0204.smollmandroid.assistant.permission.WEB_SEARCH"
        android:label="@string/perm_label"
        android:protectionLevel="signature" />

    <uses-permission android:name="io.shubham0204.smollmandroid.assistant.permission.WEB_SEARCH" />

    <!-- No library may add network access to this package. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <queries>
        <package android:name="io.shubham0204.smollmandroid.websearch" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Model inference: isolated UID (99000-99999), isolated_app SELinux
             domain, no permissions, no socket creation, no open() on app
             data. It receives a read-only model descriptor and prompt text
             over Binder and returns text. -->
        <service
            android:name=".inference.InferenceService"
            android:exported="false"
            android:isolatedProcess="true"
            android:process=":inference" />
    </application>
</manifest>
